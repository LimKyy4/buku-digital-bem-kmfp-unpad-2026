{
  "name": "buku-digital-bem-kmfp-unpad-2026",
  "version": "1.0.0",
  "description": "Buku Digital Interaktif Grand Design Biro Keuangan BEM KMFP UNPAD 2026",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit-build.mjs",
    "verify": "npm run build && node scripts/audit-build.mjs",
    "prepare:slides": "node scripts/generate-raw-slides.mjs",
    "process:pages": "node scripts/process-pages.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "setup:audio": "node scripts/setup-audio.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "phase1:run": "node scripts/fetch-fonts.mjs && node scripts/setup-audio.mjs && node scripts/process-pages.mjs && node scripts/verify-assets.mjs",
    "phase1:all": "node scripts/generate-raw-slides.mjs && npm run phase1:run"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "page-flip": "^2.0.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vercel": "^65.11.0",
    "vite": "^6.0.3"
  }
}
